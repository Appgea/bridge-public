{
  "permissions": {
    "deny": [
      "Read(//__PORTFOLIO_ROOT__/vault/secrets/**)",
      "Read(/vault/secrets/**)",
      "Edit(//__PORTFOLIO_ROOT__/vault/secrets/**)",
      "Bash(cat vault/secrets/*)",
      "Bash(cat ./vault/secrets/*)",
      "Bash(less vault/secrets/*)",
      "Bash(head vault/secrets/*)",
      "Bash(tail vault/secrets/*)",
      "Read(//__SECRETS_DIR__/*.jks)",
      "Read(//__SECRETS_DIR__/*.p8)",
      "Read(//__SECRETS_DIR__/*.cer)",
      "Read(//__SECRETS_DIR__/*.mobileprovision)",
      "Read(//__SECRETS_DIR__/*.env)",
      "Read(//__SECRETS_DIR__/*key*.json)",
      "Edit(//__SECRETS_DIR__/**)"
    ],
    "allow": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-vault.sh" }
        ]
      }
    ]
  }
}
